# TLS Caddyfile for production. Env vars come from the caddy systemd unit
# (BASE_DOMAIN, ACME_EMAIL, LINODE_API_TOKEN). Requires a Caddy built with
# the Linode DNS module:  xcaddy build --with github.com/caddy-dns/linode
# The wildcard cert is issued via DNS-01 so any *.yourdomain.com works.

{
	email {$ACME_EMAIL}
	admin off
}

(app) {
	@api path /rpc /events
	handle @api {
		reverse_proxy 127.0.0.1:8787 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8787
	}
}

# Apex → default family (home)
{$BASE_DOMAIN} {
	import app
}

# Every subdomain → one family
*.{$BASE_DOMAIN} {
	tls {
		dns linode {$LINODE_API_TOKEN}
	}
	import app
}
