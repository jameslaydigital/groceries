# Syncart config — copy to `.env` and fill in. Loaded automatically by the
# server and scripts (scripts/load-env.mjs); real environment variables and
# systemd Environment= lines always win over this file.
#
# Everything is optional — every value here is the built-in default.

# PORT=8787
# BIND_HOST=127.0.0.1
# DEFAULT_SUBDOMAIN=home

# Bare hosts (e.g. a server IP before DNS/wildcards are wired) that map to the
# default family. Comma-separated.
# DEFAULT_HOSTS=23.239.29.165

# Parent-domain cookie (e.g. .progressive-apps.com) so a user's session follows
# them across family subdomains. Leave unset for host-only cookies.
# COOKIE_DOMAIN=.progressive-apps.com
# COOKIE_SECURE=1

# Seconds-lockout window for failed login/signup attempts.
# AUTH_RATE_MS=1000

# Where databases live (defaults to the repo dir).
# DATA_DIR=families
# PLATFORM_DB=platform.db

# Used by scripts:
# SYNCART_HOST=syncart              # ssh alias for `npm run deploy`
# BACKUP_DIR=backups                # `npm run backup` output dir
# KEEP_BACKUPS=30                   # backups to retain
